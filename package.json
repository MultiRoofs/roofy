    "devcontainer:up": "devcontainer up --workspace-folder . --docker-path podman",
    "devcontainer:exec": "devcontainer exec --workspace-folder . --docker-path podman",
    "devcontainer:shell": "bash .devcontainer/attach-container.sh podman",
    "lint": "vp lint . --fix",
    "test": "vp test run",
